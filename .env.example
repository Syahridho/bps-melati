APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost
API_KEY=melati-secret-api-key

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Kebijakan satu sesi aktif per akun (lihat config/session_policy.php).
# true = satu akun hanya boleh dipakai satu perangkat/tab pada satu waktu.
SESSION_SINGLE=true
# Sesi dianggap aktif bila aktivitas terakhir lebih baru dari ambang ini (menit).
# Melewati ambang = sesi basi, boleh digantikan otomatis tanpa konfirmasi.
SESSION_ACTIVE_THRESHOLD_MINUTES=5
# Batas inaktivitas sebelum sesi dianggap berakhir. Samakan dengan SESSION_LIFETIME.
SESSION_INACTIVITY_MINUTES=120
# Izinkan pengguna mengambil alih sesinya sendiri (tetap wajib password ulang).
SESSION_ALLOW_TAKEOVER=true
# Selisih minimum sebelum last_activity_at ditulis ulang ke database (detik).
SESSION_ACTIVITY_WRITE_THROTTLE=60
# Umur token API (Sanctum) untuk klien mobile dalam menit.
AUTH_TOKEN_EXPIRATION=10080
# Retensi audit log autentikasi dalam hari.
AUTH_LOG_RETENTION_DAYS=90

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (WebSocket). Broadcast event memakai antrean terpisah "broadcasts",
# jadi worker wajib menjalankan php artisan queue:work.
REVERB_APP_ID=979893
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

#WAJIB true bila aplikasi dijalankan lebih dari satu proses/server Reverb,
# agar semua node memakai channel pub/sub yang sama.
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=reverb

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
